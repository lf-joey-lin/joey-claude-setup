[Unit]
Description=Forward Teams thread replies back into herdr agents
After=default.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
Environment=HERDR_LISTEN_USER_ID=0761494c-26c5-4345-ab0c-b83d84c1be16
ExecStart=%h/.local/bin/herdr-teams-listen
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
