#!/usr/bin/env bash
# Turn the Teams sync on and off, and show what it is doing.
# Usage: herdr-teams-toggle [panel|toggle|on|off|status|autostart
#                           |cards|cards-on|cards-off|replies|replies-on|replies-off]
# teams-sync is both halves at once: cards out (herdr-teams-watch) and replies back in
#   (herdr-teams-listen). toggle/on/off move the pair, which is what the walk-away chord
#   wants. They stay two units, and cards/replies still switch one on its own, because
#   cards-without-replies is the setting where Teams can page you without anything in
#   Teams being able to type into a live agent.
set -uo pipefail

UNIT=herdr-teams-watch.service
LISTEN_UNIT=herdr-teams-listen.service
WEBHOOK="$HOME/.config/herdr/teams-webhook"
REPLIES_WEBHOOK="$HOME/.config/herdr/teams-replies-webhook"
HERDR_BIN="${HERDR_BIN_PATH:-$(command -v herdr || echo "$HOME/.local/bin/herdr")}"

active() { systemctl --user is-active --quiet "${1:-$UNIT}"; }
enabled() { [ "$(systemctl --user is-enabled "${1:-$UNIT}" 2>/dev/null)" = enabled ]; }
both_active() { active "$UNIT" && active "$LISTEN_UNIT"; }

# journalctl only, never the unit state: a watcher whose PATH cannot find herdr sits
# there reporting active while doing nothing, so the startup line is the real check.
journal() { journalctl --user -u "${2:-$UNIT}" --no-pager -o short-iso -n "${1:-500}" 2>/dev/null; }

# journalctl's own line, cut down to the clock time and the watcher's message.
messages() { journal "${1:-500}" "${2:-$UNIT}" | sed -E 's/^[0-9-]+T([0-9]{2}:[0-9]{2}):[0-9]{2}[^ ]* [^ ]+ [^:]+: /\1 /'; }

status() {
    local cards=OFF replies=OFF sync ac=off ar=off line

    active "$UNIT" && cards=ON
    active "$LISTEN_UNIT" && replies=ON
    # PARTIAL rather than a single ON/OFF, because one unit up and one down is a real
    # state and calling it either would be a lie.
    if [ "$cards" = ON ] && [ "$replies" = ON ]; then sync=ON
    elif [ "$cards" = OFF ] && [ "$replies" = OFF ]; then sync=OFF
    else sync=PARTIAL; fi

    enabled "$UNIT" && ac=on
    enabled "$LISTEN_UNIT" && ar=on

    printf 'teams-sync:    %s\n' "$sync"
    printf '  cards out:   %-3s  (autostart %s)\n' "$cards" "$ac"
    printf '  replies in:  %-3s  (autostart %s)\n' "$replies" "$ar"

    if [ -s "$WEBHOOK" ]; then printf 'webhook:       present\n'
    else printf 'webhook:       MISSING, no card can send (see herdr-teams/README.md)\n'; fi

    if [ -s "$REPLIES_WEBHOOK" ]; then printf 'replies url:   present\n'
    else printf 'replies url:   MISSING, no reply can come back (see herdr-teams/README.md)\n'; fi

    line=$(messages | grep 'watching every' | tail -1)
    printf 'watching:      %s\n' "${line:-no startup line in the journal}"

    line=$(messages 500 "$LISTEN_UNIT" | grep 'listening every' | tail -1)
    printf 'listening:     %s\n' "${line:-no startup line in the journal}"

    # The listener's per-pass line, which is the only place the next poll time appears.
    # The listener stamps its own clock, so drop journalctl's or the line reads twice.
    line=$(messages 500 "$LISTEN_UNIT" | grep -E 'next [0-9]{2}:|nothing to poll' | tail -1 | sed -E 's/^[0-9]{2}:[0-9]{2} //')
    printf 'next poll:     %s\n' "${line:-nothing yet}"

    printf 'last cards:\n'
    local cardlog
    cardlog=$(messages | grep -E 'notify:|heartbeat:' | tail -5 | sed 's/^/  /')
    printf '%s\n' "${cardlog:-  none yet}"

    printf 'last replies:\n'
    local reps
    reps=$(messages 500 "$LISTEN_UNIT" | grep -E 'reply ->' | tail -5 | sed 's/^/  /')
    printf '%s\n' "${reps:-  none yet}"
}

toast() {
    [ -x "$HERDR_BIN" ] || return 0
    "$HERDR_BIN" notification show "$1" --body "$2" >/dev/null 2>&1 || true
}

cards_on() {
    systemctl --user start "$UNIT" && sleep 1
    active "$UNIT" && toast 'teams cards on' 'blocked and finished agents ping Teams' \
        || toast 'teams cards failed to start' 'journalctl --user -u herdr-teams-watch -n 20'
}

cards_off() {
    systemctl --user stop "$UNIT"
    toast 'teams cards off' 'the sidebar is the only signal now'
}

replies_on() {
    systemctl --user start "$LISTEN_UNIT" && sleep 1
    active "$LISTEN_UNIT" && toast 'teams replies on' 'a reply in a thread reaches its agent' \
        || toast 'teams replies failed to start' 'journalctl --user -u herdr-teams-listen -n 20'
}

replies_off() {
    systemctl --user stop "$LISTEN_UNIT"
    toast 'teams replies off' 'nothing in Teams can type into an agent'
}

sync_on() {
    systemctl --user start "$UNIT" "$LISTEN_UNIT" && sleep 1
    both_active && toast 'teams-sync on' 'cards go out, replies come back' \
        || toast 'teams-sync only half started' 'herdr-teams-toggle status'
}

sync_off() {
    systemctl --user stop "$UNIT" "$LISTEN_UNIT"
    toast 'teams-sync off' 'no cards out, and nothing can type into an agent'
}

# Half on counts as off, so one press from PARTIAL gets everything running rather
# than shutting down the half that was already working.
sync_toggle() { if both_active; then sync_off; else sync_on; fi; }

autostart() {
    if enabled "$UNIT" && enabled "$LISTEN_UNIT"; then
        systemctl --user disable "$UNIT" "$LISTEN_UNIT"
    else
        systemctl --user enable "$UNIT" "$LISTEN_UNIT"
    fi
}

case "${1:-panel}" in
    status) status ;;
    on) sync_on ;;
    off) sync_off ;;
    toggle) sync_toggle ;;
    cards) active "$UNIT" && cards_off || cards_on ;;
    cards-on) cards_on ;;
    cards-off) cards_off ;;
    replies) active "$LISTEN_UNIT" && replies_off || replies_on ;;
    replies-on) replies_on ;;
    replies-off) replies_off ;;
    autostart) autostart ;;
    panel)
        while :; do
            clear
            status
            printf '\n  [space] teams-sync   [c] cards   [i] replies   [a] autostart   [r] restart   [l] logs   [q] close\n'
            # IFS= or read eats the space, which is the on/off key.
            IFS= read -rsn1 key
            case "$key" in
                ' ') if both_active; then systemctl --user stop "$UNIT" "$LISTEN_UNIT"
                     else systemctl --user start "$UNIT" "$LISTEN_UNIT"; fi; sleep 1 ;;
                c) active "$UNIT" && systemctl --user stop "$UNIT" || systemctl --user start "$UNIT"; sleep 1 ;;
                i) active "$LISTEN_UNIT" && systemctl --user stop "$LISTEN_UNIT" || systemctl --user start "$LISTEN_UNIT"; sleep 1 ;;
                a) "$0" autostart >/dev/null 2>&1 ;;
                r) systemctl --user restart "$UNIT" "$LISTEN_UNIT"; sleep 2 ;;
                l) journalctl --user -u "$UNIT" -u "$LISTEN_UNIT" -n 200 --no-pager | less -R ;;
                q|$'\e') exit 0 ;;
            esac
        done
        ;;
    *) printf 'usage: herdr-teams-toggle [panel|toggle|on|off|status|autostart|cards|cards-on|cards-off|replies|replies-on|replies-off]\n' >&2; exit 2 ;;
esac
