#!/usr/bin/env bash
# Watch every herdr agent and ping Teams when one needs you or finishes.
# Usage: herdr-teams-watch [interval_seconds]
set -uo pipefail

INTERVAL="${1:-${HERDR_WATCH_INTERVAL:-5}}"
# States that count as "finished". herdr derives "done" itself and lets it decay to
# "idle", so keying on "done" alone misses a completion the poll happened to straddle.
FINISHED_STATES="${HERDR_WATCH_FINISHED:-done idle}"
# A long run is silent until it ends, which is no good for a loom run that takes an
# hour. Card every this many seconds while an agent is still working. 0 turns it off.
HEARTBEAT="${HERDR_WATCH_HEARTBEAT:-900}"
# One Teams thread per agent instead of a card per event: the first card for an agent
# starts its thread and every later one replies under it. 0 goes back to a top-level card.
THREADS="${HERDR_WATCH_THREADS:-1}"
# What counts as "one agent" for the purpose of owning a thread. "session" gives a
# thread per Claude session; "worktree" gives one per directory, shared by however
# many Claude runs happen there.
THREAD_KEY_MODE="${HERDR_WATCH_THREAD_KEY:-session}"
# A "needs input" card is useless without the thing being waited on. The transcript
# summary can only say "Waiting on AskUserQuestion": the question and its options are
# in the tool call, and a permission prompt is not in the transcript at all. So for a
# blocked agent, read the pane and card what is actually on screen. That puts whatever
# the agent is showing into the channel, which is why it can be turned off.
PANE_ON_BLOCKED="${HERDR_WATCH_PANE_ON_BLOCKED:-1}"
PANE_LINES="${HERDR_WATCH_PANE_LINES:-40}"
PANE_MAX_CHARS="${HERDR_WATCH_PANE_MAX_CHARS:-1500}"

# Resolve by absolute path. Under systemd, PATH has no ~/.local/bin, so bare
# names silently find nothing and the whole loop does nothing while looking healthy.
HERDR_BIN="${HERDR_BIN_PATH:-$(command -v herdr || echo "$HOME/.local/bin/herdr")}"
NOTIFY_BIN="${HERDR_NOTIFY_BIN:-$(command -v herdr-teams-notify || echo "$HOME/.local/bin/herdr-teams-notify")}"
TOGGLE_BIN="${HERDR_TOGGLE_BIN:-$(command -v herdr-teams-toggle || echo "$HOME/.local/bin/herdr-teams-toggle")}"
SUMMARY_BIN="${HERDR_SUMMARY_BIN:-$(command -v herdr-teams-summary || echo "$HOME/.local/bin/herdr-teams-summary")}"
SOURCE="${HERDR_WATCH_SOURCE:-$HERDR_BIN agent list}"

log() { printf '%s\n' "$*" >&2; }

# Seconds as something readable: the startup line quotes cadences, and 900 or 86400
# means nothing at a glance.
dur() {
    local s="$1"
    if   [ "$s" -lt 60 ];    then printf '%ds' "$s"
    elif [ "$s" -lt 3600 ];  then printf '%dm' $(( s / 60 ))
    elif [ "$s" -lt 86400 ]; then
        if [ $(( (s % 3600) / 60 )) -eq 0 ]; then printf '%dh' $(( s / 3600 ))
        else printf '%dh%dm' $(( s / 3600 )) $(( (s % 3600) / 60 )); fi
    else                          printf '%dd' $(( s / 86400 ))
    fi
}

for bin in "$HERDR_BIN" "$NOTIFY_BIN" "$SUMMARY_BIN"; do
    [ -x "$bin" ] || { log "FATAL: not executable: $bin"; exit 1; }
done
command -v jq >/dev/null || { log "FATAL: jq not found (PATH=$PATH)"; exit 1; }
if [ "$THREADS" = 1 ]; then
    log "watching every $(dur "$INTERVAL"); finished=${FINISHED_STATES}, plus blocked; heartbeat $(dur "$HEARTBEAT"); one thread per ${THREAD_KEY_MODE}"
else
    log "watching every $(dur "$INTERVAL"); finished=${FINISHED_STATES}, plus blocked; heartbeat $(dur "$HEARTBEAT"); threads off"
fi

declare -A LAST WORK_SINCE LAST_BEAT
warned=""

snapshot() {
    local raw err
    err=$(mktemp); raw=$($SOURCE 2>"$err"); rc=$?
    if [ $rc -ne 0 ]; then
        # herdr not running is normal and quiet after the first mention
        [ -z "$warned" ] && log "poll failed (rc=$rc): $(head -c 200 "$err")"
        warned=1; rm -f "$err"; return 0
    fi
    warned=""; rm -f "$err"
    printf '%s' "$raw" | jq -r '
        .result.agents[]?
        | [ .agent_session.value // .pane_id,
            .agent_status // "unknown",
            .agent_session.value // "",
            .cwd // "",
            .terminal_title_stripped // .name // "agent",
            .pane_id // ""
          ] | @tsv'
}

is_finished() {
    for s in $FINISHED_STATES; do [ "$s" = "$1" ] && return 0; done
    return 1
}

elapsed() {
    local s=$(( $2 - $1 ))
    if [ "$s" -ge 3600 ]; then printf '%dh %dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
    elif [ "$s" -ge 60 ]; then printf '%dm' $(( s / 60 ))
    else printf '%ds' "$s"; fi
}

# Blocked always matters. A finish only counts coming out of "working", so
# merely focusing a finished pane (done -> idle) does not page you again.
should_notify() {
    local prev="$1" status="$2"
    [ "$status" = "blocked" ] && [ "$prev" != "blocked" ] && return 0
    is_finished "$status" && [ "$prev" = "working" ] && return 0
    return 1
}

# The key the flow files an agent's thread under. The Claude session id is the
# default because it survives a watcher restart and a herdr session restore, so
# an agent keeps the same thread all the way through. Keying on the worktree
# instead gives that directory one thread across separate Claude runs, at the
# price of two panes in one worktree sharing it.
thread_key() {
    local id="$1" cwd="$2"
    case "$THREAD_KEY_MODE" in
        worktree) printf 'wt:%s' "${cwd:-unknown}" ;;
        *)        printf 'ag:%s' "$id" ;;
    esac
}

# What the agent is showing right now, cut down to the part a person would read.
# Drops the rules, the status line and the empty input box: they are always on screen
# and are never what you are being asked about.
pane_prompt() {
    local pane="$1"
    [ -n "$pane" ] || return 0
    "$HERDR_BIN" pane read "$pane" --source visible --lines "$PANE_LINES" --format text 2>/dev/null \
    | sed -e 's/[[:space:]]*$//' -e '/^[[:space:]]*❯[[:space:]]*$/d' \
    | grep -vF '────' \
    | grep -vF '📁' \
    | grep -vF 'auto mode on' \
    | awk 'NF' \
    | tail -n 20 \
    | head -c "$PANE_MAX_CHARS"
}

# A card that is meant to reach your phone. In the agent's own thread when threads
# are on, a top-level card when they are not.
send_event() {
    local id="$1" cwd="$2" pane="$3" subject="$4" body="$5"; shift 5
    local thread_args=() sync
    [ "$THREADS" = 1 ] && thread_args=(--thread "$(thread_key "$id" "$cwd")")
    # Every card says how long a reply to it still gets picked up on the fast tier, so
    # someone reading it on their phone knows their own deadline without asking. It is
    # built here, as the card goes out, rather than written by the agent into the body:
    # the agent could forget the line or get it wrong, and this cannot.
    # HERDR_PANE_ID is how the toggle finds this agent's row in the listener status, and
    # --sending measures the window from this card rather than the one it replaces.
    # A missing or slow toggle costs the line, never the card.
    sync=$(HERDR_PANE_ID="$pane" timeout 5 "$TOGGLE_BIN" next --sending 2>/dev/null) || sync=""
    # This card is proof that cards are on, so a line saying they are off is wrong rather
    # than merely unhelpful, and the fact is dropped instead of printed. It happens when
    # the toggle cannot reach the user bus and reads every unit as dead. "cards out only"
    # is a different thing and is kept: the listener really can be down while we send.
    case "$sync" in "teams-sync OFF"*) sync="" ;; esac
    [ -n "$sync" ] && set -- "$@" "Sync=$sync"
    "$NOTIFY_BIN" "${thread_args[@]}" "$subject" "$body" "$@"
}

while :; do
    now=$(date +%s)
    while IFS=$'\t' read -r id status session cwd title pane; do
        [ -n "${id:-}" ] || continue
        prev="${LAST[$id]:-}"
        LAST[$id]="$status"
        worktree="${cwd##*/}"
        [ -n "$worktree" ] || worktree="agent"

        if [ "$status" = working ]; then
            if [ "$prev" != working ]; then
                # Prefer the turn's real start from the transcript. Without it a
                # watcher restart would report a two-hour run as "running 15m".
                WORK_SINCE[$id]=$("$SUMMARY_BIN" --since "$session" "$cwd" 2>/dev/null)
                [ -n "${WORK_SINCE[$id]}" ] || WORK_SINCE[$id]=$now
                LAST_BEAT[$id]=$now
            fi
        else
            unset "WORK_SINCE[$id]" "LAST_BEAT[$id]"
        fi

        # Still-working card. Independent of the transition logic below, which only
        # ever fires when a run ends.
        if [ "$HEARTBEAT" -gt 0 ] && [ "$status" = working ] \
           && [ $(( now - ${LAST_BEAT[$id]:-$now} )) -ge "$HEARTBEAT" ]; then
            LAST_BEAT[$id]=$now
            for_how_long=$(elapsed "${WORK_SINCE[$id]:-$now}" "$now")
            doing=$("$SUMMARY_BIN" --now "$session" "$cwd" 2>/dev/null)
            loom=$("$SUMMARY_BIN" --loom "$session" "$cwd" 2>/dev/null)
            beat_facts=("Task=$title" "Running=$for_how_long")
            [ -n "$loom" ] && beat_facts+=("Loom=$loom")
            log "heartbeat: $worktree working for $for_how_long ($doing)"
            send_event "$id" "$cwd" "$pane" "$worktree: still working" "$doing" "${beat_facts[@]}" \
                || log "heartbeat send failed for $worktree"
        fi

        # An agent we have never seen is seeded, never announced. Without this you
        # get a burst of stale "finished" cards every time herdr restores a session.
        [ -z "$prev" ] && continue
        [ "$prev" = "$status" ] && continue
        should_notify "$prev" "$status" || continue

        case "$status" in
            blocked) subject="needs input" ;;
            *)       subject="finished" ;;
        esac

        # The card body is what Claude actually said last, read from its own
        # transcript. Falls back to the terminal title when there is no transcript.
        body=""; took=""
        if [ -n "$session" ]; then
            body=$("$SUMMARY_BIN" "$session" "$cwd" 2>/dev/null)
            took=$("$SUMMARY_BIN" --took "$session" "$cwd" 2>/dev/null)
        fi
        # A blocked card has to carry the prompt itself, or answering it from Teams is
        # a guess. Keep the summary as the fallback for when the pane read gives nothing.
        if [ "$status" = blocked ] && [ "$PANE_ON_BLOCKED" = 1 ]; then
            screen=$(pane_prompt "$pane")
            [ -n "$screen" ] && body="$screen"
        fi
        # No body when there is no transcript: the Task fact already carries the
        # title, and a card repeating it twice reads like a bug.
        facts=("Task=$title")
        [ -n "$took" ] && facts+=("Took=$took")
        loom=$("$SUMMARY_BIN" --loom "$session" "$cwd" 2>/dev/null)
        [ -n "$loom" ] && facts+=("Loom=$loom")

        log "notify: $worktree $prev -> $status ($title)"
        send_event "$id" "$cwd" "$pane" "$worktree: $subject" "$body" "${facts[@]}" \
            || log "send failed for $worktree"
    done < <(snapshot)
    sleep "$INTERVAL"
done
